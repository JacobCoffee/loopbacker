desc:Loopbacker Test Fixed Delay
tags: delay testing pdc
author: Loopbacker

slider1:delay_ms=10<1,100,0.1>Delay (ms)

@init
delay_samples = 0;
buf_len = 0;
buf0 = 0;
buf1 = 65536;
write_pos = 0;

@slider
new_delay_samples = floor(delay_ms * srate / 1000);
new_delay_samples < 1 ? new_delay_samples = 1;
new_delay_samples > 65536 ? new_delay_samples = 65536;
delay_samples = new_delay_samples;
pdc_delay = delay_samples;

@sample
buf0[write_pos] = spl0;
buf1[write_pos] = spl1;
read_pos = write_pos - delay_samples;
read_pos < 0 ? read_pos += 65536;
spl0 = buf0[read_pos];
spl1 = buf1[read_pos];
write_pos += 1;
write_pos >= 65536 ? write_pos = 0;
