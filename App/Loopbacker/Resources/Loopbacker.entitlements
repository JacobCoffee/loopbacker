<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Third-party AUv2 effects load in-process (AUHostNode) under the hardened runtime,
	     which otherwise refuses to dlopen code not signed with the same team ID. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Mic capture under the hardened runtime. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- REAPER JSFX effects JIT-compile their EEL2 scripts. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
